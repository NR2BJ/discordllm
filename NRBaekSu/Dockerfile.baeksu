FROM mcr.microsoft.com/dotnet/sdk:10.0 AS libdave-build
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git make cmake g++ nasm pkg-config zip unzip tar \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /tmp/libdave-src
RUN git clone --depth 1 --single-branch --recurse-submodules https://github.com/discord/libdave.git . \
    && git submodule update --init --recursive --depth 1 \
    && cd cpp \
    && ./vcpkg/bootstrap-vcpkg.sh \
    && make shared BUILD_TYPE=Release \
    && make install BUILD_TYPE=Release BUILD_SHARED_LIBS=ON

FROM mcr.microsoft.com/dotnet/sdk:10.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    libopus0 libopus-dev libsodium23 libsodium-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . ./
COPY --from=libdave-build /tmp/libdave-src/cpp/build/install /opt/libdave

RUN dotnet restore ./NRBaekSu.csproj
RUN chmod +x /app/entrypoint.sh

ENV DOTNET_EnableDiagnostics=0
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=0

CMD ["/app/entrypoint.sh"]
